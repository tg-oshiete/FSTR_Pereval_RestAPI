# Local development example only. Never use these placeholders in production.
# Copy to .env and replace the password locally; do not commit .env.
FSTR_DB_HOST=localhost
FSTR_DB_PORT=5432
FSTR_DB_NAME=fstr_example
FSTR_DB_LOGIN=fstr_example
FSTR_DB_PASS=replace-with-a-local-password
PORT=8000

# Inclusive upload limits, shared by POST/PATCH and published in OpenAPI.
FSTR_MAX_IMAGES_PER_PEREVAL=5
FSTR_MAX_IMAGE_BYTES=5242880
FSTR_MAX_IMAGES_TOTAL_BYTES=20971520
FSTR_MAX_IMAGE_PIXELS=24000000
FSTR_MAX_IMAGE_DIMENSION=12000
FSTR_MAX_REQUEST_BYTES=33554432
